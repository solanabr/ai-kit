  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat)\nV=$(awk 'NF{print $NF; exit}' \"${CLAUDE_PROJECT_DIR:-.}/.claude/VERSION\" 2>/dev/null)\n[ -n \"$V\" ] || V=dev\nif command -v solana >/dev/null 2>&1; then\n  RPC=$(solana config get json_rpc_url 2>/dev/null | awk '{print $NF}' | sed -E 's#^([a-z]+://[^/?]+).*#\\1#')\n  WALLET=$(solana address 2>/dev/null) || WALLET='none configured'\n  CTX=\"Solana CLI: RPC ${RPC:-unknown}, wallet ${WALLET:-none configured}.\"\nelse\n  CTX='Solana CLI not found on PATH.'\nfi\ncase $INPUT in *'\"startup\"'*) ;; *) printf '%s\\n' \"$CTX\"; exit 0 ;; esac\ncommand -v jq >/dev/null 2>&1 || { printf '%s\\n' \"$CTX\"; exit 0; }\nBANNER=$(printf '%s\\n' \\\n  '   _____ ____  __    ___    _   _____' \\\n  '  / ___// __ \\/ /   /   |  / | / /   |' \\\n  '  \\__ \\/ / / / /   / /| | /  |/ / /| |' \\\n  ' ___/ / /_/ / /___/ ___ |/ /|  / ___ |' \\\n  '/____/\\____/_____/_/  |_/_/ |_/_/  |_|' \\\n  '           ▄▀█ █   █▄▀ █ ▀█▀' \\\n  '           █▀█ █   █ █ █  █' \\\n  \"     v$V — by @SuperteamBR 🇧🇷\")\njq -n --arg b \"$BANNER\" --arg c \"$CTX\" '{systemMessage: $b, hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: $c}}'",
            "timeout": 15
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat)\nCMD=$(printf '%s' \"$INPUT\" | jq -r '.tool_input.command // empty' 2>/dev/null || printf '%s' \"$INPUT\")\nHIT=$(printf '%s\\n' \"$CMD\" | grep -oE '\\.ssh/|\\.gnupg|\\.aws/|\\.config/solana/id\\.json|\\.npmrc|\\.git-credentials|\\.netrc|\\.cargo/credentials|\\.docker/config\\.json|\\.config/gh/hosts|\\.kube/config|\\.pypirc|\\.gem/credentials|gh auth token|--show-token|Application[\\\\ ]+Support/Google/Chrome|Application[\\\\ ]+Support/BraveSoftware|Application[\\\\ ]+Support/Microsoft[\\\\ ]+Edge|Application[\\\\ ]+Support/Firefox|Application[\\\\ ]+Support/Chromium|Application[\\\\ ]+Support/Vivaldi|Application[\\\\ ]+Support/Arc|Application[\\\\ ]+Support/com\\.operasoftware|\\.config/google-chrome|\\.config/BraveSoftware|\\.config/microsoft-edge|\\.mozilla/firefox|\\.config/chromium|\\.config/vivaldi|\\.config/opera|AppData/Local/Google/Chrome|AppData/Local/BraveSoftware|AppData/Local/Microsoft/Edge|AppData/Roaming/Mozilla/Firefox|AppData/Local/Chromium|AppData/Local/Vivaldi|AppData/Roaming/Opera[\\\\ ]+Software|Local[\\\\ ]+Extension[\\\\ ]+Settings|moz-extension' | head -n 1)\n[ -n \"$HIT\" ] || exit 0\necho \"🛑 Blocked: reading private keys, wallet vaults or credentials is not allowed ($HIT). Use \\`solana address\\` for the pubkey; ask the user to run anything that needs the secret.\" >&2\nexit 2",
            "timeout": 10
          }
        ]
      },

      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat)\ncase $INPUT in *solana*|*anchor*|*spl-token*) ;; *) exit 0 ;; esac\nCMD=$(printf '%s' \"$INPUT\" | jq -r '.tool_input.command // empty' 2>/dev/null) || CMD=$(printf '%s' \"$INPUT\" | sed -nE 's/.*\"command\"[[:space:]]*:[[:space:]]*\"(([^\"\\\\]|\\\\.)*)\".*/\\1/p')\nRE='(^|[;&|(]|\\$\\()[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*([^[:space:];&|()]*/)?((solana|anchor) program (deploy|write-buffer|upgrade|extend|migrate|close|set-upgrade-authority|set-buffer-authority)|solana program-v4 (deploy|retract|transfer-authority|finalize)|anchor (deploy|upgrade)|solana (transfer|withdraw-stake|withdraw-from-vote-account|withdraw-from-nonce-account)|spl-token (transfer|burn|close|authorize))([[:space:]][^;&|]*)?([;&|)]|$)'\nSEG=$(printf '%s\\n' \"$CMD\" | grep -oE \"$RE\")\n[ -n \"$SEG\" ] || exit 0\nif printf '%s\\n' \"$SEG\" | grep -qE -e '--final|--bypass-warning|program-v4 finalize|spl-token authorize[^;&|]*--disable'; then\n  echo \"🛑 Blocked: irreversible on-chain action (--final, program close --bypass-warning, program-v4 finalize or authorize --disable). If the user wants it, they run it themselves outside Claude.\" >&2\n  exit 2\nfi\nset -f\nCL= SRC='command flag' prev=\nfor w in $SEG; do\n  case $prev in --url|-u|--provider.cluster) CL=$w ;; esac\n  case $w in --url=*|--provider.cluster=*) CL=${w#*=} ;; -u?*) CL=${w#-u} ;; esac\n  prev=$w\ndone\nif [ -z \"$CL\" ]; then\n  case $SEG in\n    *anchor*) SRC=Anchor.toml; CL=$(awk -F'\"' '/^[[:space:]]*cluster[[:space:]]*=/{print $2; exit}' Anchor.toml 2>/dev/null) ;;\n    *) SRC='solana config'; CL=$(solana config get json_rpc_url 2>/dev/null | awk '{print $NF}') ;;\n  esac\nfi\nCL=$(printf '%s' \"${CL#=}\" | tr '[:upper:]' '[:lower:]' | sed -E 's#^([a-z]+://[^/?]+).*#\\1#' | tr -cd 'a-z0-9:/._-')\ncase $CL in\n  m|*mainnet*) R=\"MAINNET (from $SRC): spends real SOL or changes a live program. Approve only if the user asked for mainnet.\" ;;\n  d|*devnet*) R=\"On-chain write to devnet (from $SRC).\" ;;\n  t|*testnet*) R=\"On-chain write to testnet (from $SRC).\" ;;\n  l|localnet|*localhost*|*127.0.0.1*) R=\"On-chain write to localnet (from $SRC).\" ;;\n  '') R='On-chain write to an unknown cluster (no --url, Anchor.toml or solana config found). Check the target before approving.' ;;\n  *) R=\"On-chain write to $CL (from $SRC). Check the cluster before approving.\" ;;\nesac\nprintf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"%s\"}}\\n' \"$R\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
