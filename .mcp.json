{
  "mcpServers": {
    "helius": {
      "command": "npx",
      "args": ["-y", "helius-mcp@2.2.0"],
      "env": {
        "HELIUS_API_KEY": "${HELIUS_API_KEY:-}"
      }
    },
    "solana-dev": {
      "type": "http",
      "url": "https://mcp.solana.com/mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    },
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode@1.0.169"]
    }
  }
}
