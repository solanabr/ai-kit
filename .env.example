# Helius API — get a key at https://dev.helius.xyz
HELIUS_API_KEY=

# Colosseum Copilot needs no key here: the core colosseum skill signs in through its own
# helper, which keeps the credential in the OS store. Run it once per machine (Node 20+):
#   npx @colosseum-org/copilot-connect login     (add --device where no browser can open)
#   npx @colosseum-org/copilot-connect status | logout | revoke
# COLOSSEUM_COPILOT_PAT and an api/v1 base are leftovers from the retired v1 auth; if you
# still have them set, remove them — v1 tokens stop working 2026-10-28.

# QEDGen formal verification (optional) — requires qedgen CLI
# MISTRAL_API_KEY: fill-sorry/generate, key at https://console.mistral.ai
# ARISTOTLE_API_KEY: aristotle commands, key at https://aristotle.harmonic.fun
MISTRAL_API_KEY=
ARISTOTLE_API_KEY=

# TheGrid (optional) — for Colosseum project graph queries
# Get a key at https://thegrid.id
THEGRID_API_KEY=
THEGRID_GRAPHQL_ENDPOINT=https://beta.node.thegrid.id/graphql

# QuickNode (optional) — for QuickNode RPC/Streams/DAS
# Get endpoints at https://www.quicknode.com
QUICKNODE_RPC_URL=
QUICKNODE_WSS_URL=
QUICKNODE_API_KEY=

# X/Twitter (optional) — for CT alpha research skill
# Get a bearer token at https://developer.x.com
X_BEARER_TOKEN=

# DFlow (optional) — for DFlow order flow integration
DFLOW_API_KEY=
